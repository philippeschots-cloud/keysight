; Engine configuration file.
; Piano VR - stap 1: MIDI-test voor Steam Frame (standalone, Linux ARM64)

config_version=5

[application]

config/name="Piano VR MIDI Test"
config/description="Stap 1: controleert of de Clavinova via USB-MIDI binnenkomt op de Steam Frame, en of passthrough beschikbaar is."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "Mobile")

[display]

window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true

[xr]

openxr/enabled=true
openxr/startup_alert=false
openxr/environment_blend_mode=0
shaders/enabled=true
